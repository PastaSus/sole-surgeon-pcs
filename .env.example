# Airtable personal access token with data.records:read and data.records:write
AIRTABLE_API_KEY=

# The base that contains the Batches, Tasks, and Items tables
AIRTABLE_BASE_ID=

# Optional table-name overrides (defaults shown)
AIRTABLE_BATCHES_TABLE=Batches
AIRTABLE_TASKS_TABLE=Tasks
AIRTABLE_ITEMS_TABLE=Items
